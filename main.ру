import cv2
import numpy as np

def detect_plastic_on_satellite(image_path):
    # 1. Загрузка спутникового снимка
    image = cv2.imread(image_path)
    if image is None:
        return "Ошибка: Файл изображения не найден."

    # 2. Преобразование в цветовое пространство HSV для лучшего распознавания
    hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)

    # 3. Определение диапазона цветов для пластика (белые, синие, яркие частицы)
    # Эти параметры можно подстраивать под конкретные снимки
    lower_val = np.array([0, 0, 180]) 
    upper_val = np.array([180, 50, 255])

    # 4. Создание маски: выделяем только те пиксели, которые попадают в диапазон
    mask = cv2.inRange(hsv, lower_val, upper_val)

    # 5. Поиск контуров (конкретных объектов мусора)
    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    detected_count = 0
    for cnt in contours:
        # Игнорируем слишком маленькие объекты (шум)
        if cv2.contourArea(cnt) > 20:
            x, y, w, h = cv2.boundingRect(cnt)
            # Рисуем зеленую рамку вокруг найденного пластика
            cv2.rectangle(image, (x, y), (x + w, y + h), (0, 255, 0), 2)
            detected_count += 1

    # 6. Сохранение результата
    cv2.imwrite('result_map.png', image)
    print(f"Анализ завершен. Обнаружено объектов: {detected_count}")
    print("Результат сохранен в файл 'result_map.png'")

if __name__ == "__main__":
    # Для теста можно использовать любой скриншот спутниковой карты
    detect_plastic_on_satellite('satellite_img.png')
